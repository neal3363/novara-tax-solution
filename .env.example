# Signed session secret (min 32 characters). Required.
AUTH_SECRET=

# password | oidc | both
AUTH_MODE=password

# Bump to invalidate all existing sessions.
AUTH_SESSION_VERSION=2

# JSON array of individual users with unique scrypt password hashes and TOTP secrets.
# Never commit real values. Each user must have their own passwordHash (no shared password).
AUTH_USERS_JSON=

# Optional production OIDC IdP (required when AUTH_MODE=oidc or both)
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
AUTH_OIDC_SCOPES=openid profile email
