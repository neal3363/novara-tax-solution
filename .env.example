# === Authentication (does NOT enable live asset connectors) ===

# HMAC session signing key (>=32 chars). Secret.
AUTH_SECRET=

# password | oidc | both
AUTH_MODE=password

# Bump to invalidate all sessions
AUTH_SESSION_VERSION=2

# Provisioned users JSON (roles/orgs/hashes/TOTP). Secret.
# OIDC users must appear here by email — no self-registration into privileged roles.
AUTH_USERS_JSON=

# OIDC IdP
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
# Exact redirect URI registered with the IdP (see docs/AUTH_CONFIGURATION.md).
AUTH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
AUTH_OIDC_SCOPES=openid profile email

# === Platform DB (durable rate-limit + audit across instances) ===
# Set automatically for Cursor apps that declare postgres in cursor-app.json.
# DATABASE_URL=
