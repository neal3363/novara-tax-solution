# NOVARA public demo — synthetic only. Copy values into hosting secrets manager.
# Do NOT put live Stripe/MeF/KMS production secrets here.

VITE_NOVARA_PUBLIC_DEMO=true

# Live integrations must remain unset / false
# NOVARA_LIVE_IRS_FILING=false
# NOVARA_LIVE_PAYMENTS=false
# NOVARA_LIVE_BANKING=false

# Hosting / domain (owner-configured — do not purchase or change DNS without approval)
# NOVARA_PUBLIC_HOSTNAME=
# NOVARA_TLS_TERMINATION=provider

# Optional monitoring endpoints (not activated by this demo prep)
# NOVARA_ERROR_REPORTING_DSN=
# NOVARA_APM_ENDPOINT=
